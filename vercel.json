{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!works-packets/|manuals/|assets/|art/|photos/|covers/|studio/|memories/|collections/|reviews/|favicon.svg|reviews-paper.svg|biography.html|CNAME).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/works-packets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
